# ─── Safre Manasik SaaS — Production Environment Template ─────────────────
# Copy to .env.production and fill in real values BEFORE running:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# DO NOT commit the filled-in .env.production to version control.
# In real production, source these from AWS Secrets Manager / Azure Key Vault.

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=safre_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_32_CHARS_MIN
POSTGRES_DB=safre_manasik

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── JWT ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_48_FOR_THIS_VALUE_PLEASE_CHANGE
JWT_EXPIRES_IN=7d

# ─── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.safremanasik.com
REACT_APP_API_URL=https://api.safremanasik.com/api

# ─── Image tag (for blue/green deployments) ───────────────────────────────
IMAGE_TAG=latest

# ─── Moyasar (Saudi payment gateway) ──────────────────────────────────────
# Get from https://moyasar.com after KYC. Until then leave as "stub".
MOYASAR_PUBLISHABLE_KEY=stub
MOYASAR_SECRET_KEY=stub

# ─── Optional: Sentry error tracking ──────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ─── Optional: SMTP for outgoing email ────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@safremanasik.com
