{
  "expo": {
    "name": "Safre Manasik",
    "slug": "safre-manasik",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safremanasik",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2B1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safremanasik.app"
    },
    "android": {
      "package": "com.safremanasik.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D2B1A"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://api.safremanasik.com/api"
    }
  }
}
