generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  CUSTOMER
}

enum CustomerType {
  B2C
  B2B
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
}

// Vehicle type is a free, tenant-configurable string (managed via the
// `vehicle_types` System Config key) — no longer a fixed enum.

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHEQUE
  PAYPAL
  MOYASAR
  STRIPE
}

enum HotelCity {
  MAKKAH
  MADINAH
  JEDDAH
  TAIF
}

enum VoucherType {
  TENTATIVE
  CONFIRMED
}

enum TenantPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

// ─── TenantApplication ──────────────────────────────────────────────────────
// New tenant signups land here first as PENDING. SUPER_ADMIN reviews and
// either approves (which creates the Tenant + admin User) or rejects (which
// keeps the row for audit). adminPasswordHash is bcrypt'd at submit time so
// the plaintext password is never persisted on disk.
enum TenantApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model TenantApplication {
  id                 String                  @id @default(uuid())
  tenantName         String
  contactEmail       String?
  contactPhone       String?
  crNumber           String?
  vatNumber          String?
  umrahLicenseNumber String?
  city               String?
  country            String?

  adminName          String
  adminEmail         String                  @unique
  adminPasswordHash  String                  // bcrypt-hashed at submit time

  status             TenantApplicationStatus @default(PENDING)
  reviewNotes        String?                 // free-form notes the reviewer attaches
  rejectionReason    String?
  reviewedById       String?                 // SUPER_ADMIN user id who decided
  reviewedAt         DateTime?

  // Once approved, we keep links to the created tenant + user for traceability.
  approvedTenantId   String?
  approvedUserId     String?

  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([status])
  @@index([adminEmail])
  @@map("tenant_applications")
}

// ─── PlanConfig (configurable plan defaults + features) ─────────────────────
// SUPER_ADMIN edits these to define what each plan offers — no hardcoding.
// Tenant.maxUsers/maxBookings override these defaults when set; otherwise
// PlanConfig.defaultMaxUsers/defaultMaxBookings apply.
// `features` is a JSON map of feature flag keys to booleans, e.g.:
//   { "pdfVouchers": true, "reports": true, "apiAccess": false, "customBranding": false }
// Add new feature keys here as the product grows — no schema migration needed.
model PlanConfig {
  id                 String     @id @default(uuid())
  plan               TenantPlan @unique
  displayName        String
  description        String?
  defaultMaxUsers    Int        @default(10)
  defaultMaxBookings Int        @default(100)
  features           Json       @default("{}")
  priceMonthly       Decimal?   @db.Decimal(10, 2)
  priceCurrency      String     @default("SAR")
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("plan_configs")
}

// ─── Tenant (top-level container) ───────────────────────────────────────────

model Tenant {
  id                  String       @id @default(uuid())
  slug                String       @unique
  name                String
  contactEmail        String
  contactPhone        String?
  crNumber            String?
  vatNumber           String?
  umrahLicenseNumber  String?
  umrahLicenseExpiry  DateTime?
  address             String?
  city                String?
  country             String       @default("Saudi Arabia")
  currency            String       @default("SAR")
  timezone            String       @default("Asia/Riyadh")
  language            String       @default("en")
  logoUrl             String?
  primaryColor        String       @default("#0D7377")
  plan                TenantPlan   @default(STARTER)
  status              TenantStatus @default(TRIAL)
  trialEndsAt         DateTime?
  maxUsers            Int          @default(10)
  maxBookings         Int          @default(100)

  // ── Per-tenant PayPal configuration ────────────────────────────────────
  // Each tenant supplies their own PayPal API keys via Tenant Settings.
  // If paypalEnabled is false (or credentials are empty), the payment
  // gateway falls back to the platform-level env vars (PAYPAL_CLIENT_ID/
  // PAYPAL_CLIENT_SECRET). If neither is set, stub mode is used.
  paypalEnabled       Boolean      @default(false)
  paypalMode          String?      // "sandbox" | "live"
  paypalClientId      String?
  paypalSecret        String?      // stored as plaintext today; encrypt-at-rest is a follow-up

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users           User[]
  hotels          Hotel[]
  packages        Package[]
  bookings        Booking[]
  vehicles        Vehicle[]
  routes          Route[]
  cateringVendors CateringVendor[]
  vouchers        Voucher[]
  payments        Payment[]
  invoices        Invoice[]
  systemConfigs   SystemConfig[]

  // ── CRM relations ───────────────────────────────────────────────────────
  crmConfig          CrmConfig?
  crmLeads           CrmLead[]
  crmLeadActivities  CrmLeadActivity[]
  crmPipelines       CrmPipeline[]
  crmPipelineStages  CrmPipelineStage[]
  crmOpportunities   CrmOpportunity[]
  crmOppActivities   CrmOpportunityActivity[]
  crmTasks           CrmTask[]
  crmConversations   CrmConversation[]
  crmMessages        CrmMessage[]
  crmIntegrations    CrmIntegration[]
  crmAutomationRules CrmAutomationRule[]
  crmNotifications   CrmNotification[]

  formVouchers       FormVoucher[]
  voucherInvoices    VoucherInvoice[]
  fleetTrips         FleetTrip[]
  fleetCashLogs      FleetCashLog[]
  fleetMaintenance   FleetMaintenance[]
  tenantRoles        TenantRole[]
  rolePermissions    RolePermission[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(uuid())
  tenantId     String?       // NULL for SUPER_ADMIN (cross-tenant)
  name         String
  email        String        @unique
  password     String
  role         Role          @default(CUSTOMER)
  customerType CustomerType? @default(B2C)
  phone        String?
  companyName  String?
  crNumber     String?
  vatNumber    String?
  address      String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  bookingsAsAgent    Booking[] @relation("AgentBookings")
  packages           Package[] @relation("AgentPackages")

  // ── CRM back-relations ──────────────────────────────────────────────────
  crmLeadsAssigned    CrmLead[]               @relation("CrmLeadAgent")
  crmLeadActivities   CrmLeadActivity[]       @relation("CrmActivityUser")
  crmOppsAssigned     CrmOpportunity[]        @relation("CrmOpportunityAgent")
  crmOppActivities    CrmOpportunityActivity[] @relation("CrmOppActivityUser")
  crmTasksAssigned    CrmTask[]               @relation("CrmTaskAgent")
  crmTasksCreated     CrmTask[]               @relation("CrmTaskCreator")
  crmConvsAssigned    CrmConversation[]       @relation("CrmConvAgent")
  crmMessagesSent     CrmMessage[]            @relation("CrmMsgSender")
  crmNotifications    CrmNotification[]       @relation("CrmUserNotifications")
  passwordResetTokens PasswordResetToken[]

  // ── RBAC: optional custom role (overrides the legacy `role` enum when set) ──
  customRoleId String?
  customRole   TenantRole? @relation("UserCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([role])
  @@map("users")
}

// ─── Customer registry ────────────────────────────────────────────────────────
// ─── Form Voucher (standalone hotel / transport vouchers) ─────────────────────
// Distinct from booking-based Voucher. Created via the voucher form, supports a
// Tentative→Confirmed lifecycle with an HCN reference, and its own SAF-prefixed
// voucher number sequence (per tenant, per month).

model FormVoucher {
  id        String @id @default(uuid())
  tenantId  String
  voucherNo String
  type      String // 'HOTEL' | 'TRANSPORT'
  status    String @default("TENTATIVE") // 'TENTATIVE' | 'CONFIRMED'
  hcn       String? // Hotel Confirmation Number — set on confirm

  // Common party fields
  companyName String?
  firstName   String
  lastName    String
  mobile      String
  whatsapp    String?
  passport    String

  // Hotel-specific. A hotel voucher may hold MULTIPLE trips (segments). `trips`
  // is a JSON array of { hotelName, hotelId, checkInDate, checkOutDate,
  // perNightPrice, nights, lineTotal }. The single-hotel columns below are kept
  // for backward compatibility (populated from trips[0]) and as a fallback for
  // older single-trip vouchers created before multi-trip support.
  trips         Json?
  hotelId       String?
  hotelName     String?
  checkInDate   DateTime?
  checkOutDate  DateTime?
  perNightPrice Decimal?  @db.Decimal(10, 2)

  // Transport-specific
  vehicleType     String?
  pickupLocation  String?
  dropoffLocation String?
  travelDate      DateTime?
  passengerCount  Int?
  transportPrice  Decimal?  @db.Decimal(10, 2)

  // Totals + audit trail (user ids — no FK to avoid back-relation churn on User)
  totalValue    Decimal?  @db.Decimal(12, 2)
  vatRate       Decimal?  @db.Decimal(5, 4)  // snapshot of VAT rate at issue (e.g. 0.1500)
  // Payment tracking (direct-voucher bookings). Status is set only via the
  // audited recordPayment endpoint — never freely editable.
  paymentStatus String   @default("UNPAID") // 'UNPAID' | 'PAID'
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?

  createdById   String?
  confirmedById String?
  modifiedById  String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices VoucherInvoice[]

  @@unique([tenantId, voucherNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("form_vouchers")
}

// ─── Direct-voucher invoices: Proforma (tentative) + Actual (confirmed) ───────
// Auto-generated from a FormVoucher. Proforma is created/refreshed while the
// voucher is tentative; the Actual (tax) invoice is issued on confirmation.
// Numbers come from a per-tenant, per-month atomic counter (see DocSequence) and
// never reset mid-month: SAFPI/SAFAI + YYYY + MM + zero-padded sequence.
model VoucherInvoice {
  id          String   @id @default(uuid())
  tenantId    String
  voucherId   String
  docType     String   // 'PROFORMA' | 'ACTUAL'
  number      String
  status      String   @default("ACTIVE") // 'ACTIVE' | 'CANCELLED'
  subtotal    Decimal  @default(0) @db.Decimal(12, 2)
  vatRate     Decimal? @db.Decimal(5, 4)
  vatAmount   Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("SAR")
  snapshot    Json?
  createdById String?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voucher FormVoucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([voucherId])
  @@index([tenantId, docType])
  @@map("voucher_invoices")
}

// Atomic monthly document-number counter. One row per (tenant, docType, period).
// Incremented via INSERT ... ON CONFLICT so concurrent issues never collide.
model DocSequence {
  tenantId  String
  docType   String
  period    String   // 'YYYYMM'
  lastSeq   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([tenantId, docType, period])
  @@map("doc_sequences")
}

// ─── RBAC: tenant-defined roles + permission grants ───────────────────────────
// Built-in roles (ADMIN/AGENT/CUSTOMER) are seeded per tenant as isSystem=true:
// their permissions are editable but they can't be deleted. Custom roles are
// isSystem=false. Permissions are deny-by-default (positive grants only).

model TenantRole {
  id          String   @id @default(uuid())
  tenantId    String
  key         String   // 'ADMIN' | 'AGENT' | 'CUSTOMER' | 'custom_<slug>'
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]           @relation("UserCustomRole")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_roles")
}

model RolePermission {
  id        String   @id @default(uuid())
  tenantId  String
  roleId    String
  feature   String   // catalog key, e.g. 'bookings'
  action    String   // 'view' | 'create' | 'edit' | 'delete' | 'export'
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, feature, action])
  @@index([tenantId])
  @@map("role_permissions")
}

// ─── Hotel ──────────────────────────────────────────────────────────────────

model Hotel {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  city        HotelCity
  stars       Int       @default(3)
  address     String?
  description String?
  amenities   String[]
  distanceToHaramMeters Int?
  pricePerNight Decimal? @db.Decimal(10, 2) // selling price/night — used by the voucher form
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageHotels PackageHotel[]

  @@index([tenantId])
  @@index([tenantId, city])
  @@map("hotels")
}

// ─── Package ────────────────────────────────────────────────────────────────

model Package {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  description         String?
  durationDays        Int
  transportIncluded   Boolean  @default(true)
  cateringIncluded    Boolean  @default(true)
  visaIncluded        Boolean  @default(false)
  airportTransfer     Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceTiers    PriceTier[]
  packageHotels PackageHotel[]
  bookings      Booking[]
  agents        User[]         @relation("AgentPackages")

  @@index([tenantId])
  @@map("packages")
}

model PriceTier {
  id          String  @id @default(uuid())
  packageId   String
  tierName    String
  pricePerPax Decimal @db.Decimal(10, 2)
  roomType    String
  minPax      Int     @default(1)
  maxPax      Int?
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("price_tiers")
}

model PackageHotel {
  id        String    @id @default(uuid())
  packageId String
  hotelId   String
  city      HotelCity
  nights    Int
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([packageId, hotelId])
  @@map("package_hotels")
}

// ─── Booking ────────────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(uuid())
  tenantId       String
  bookingRef     String        @unique @default(cuid())
  customerId     String
  agentId        String?
  packageId      String?
  priceTierId    String?
  status         BookingStatus @default(TENTATIVE)
  travelDateFrom DateTime
  travelDateTo   DateTime
  totalPax       Int
  totalAmount    Decimal       @db.Decimal(10, 2)
  currency       String        @default("SAR")
  notes          String?
  // Itinerary line-items (Direct-Voucher style). Each is a JSON array:
  //   hotelTrips: { hotelId, hotelName, checkInDate, checkOutDate, rooms, perNightPrice, nights, lineTotal }
  //   transportTrips: { vehicleType, pickupLocation, dropoffLocation, travelDate, passengerCount, price, lineTotal }
  // When present, totalAmount is auto-computed from the sum of line totals.
  hotelTrips     Json?
  transportTrips Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     User               @relation("CustomerBookings", fields: [customerId], references: [id])
  agent        User?              @relation("AgentBookings", fields: [agentId], references: [id])
  package      Package?           @relation(fields: [packageId], references: [id])
  passengers   Passenger[]
  transports   BookingTransport[]
  caterings    BookingCatering[]
  vouchers     Voucher[]
  payments     Payment[]
  invoice      Invoice?

  @@index([tenantId])
  @@index([tenantId, travelDateFrom])
  @@index([tenantId, status])
  @@map("bookings")
}

model Passenger {
  id           String   @id @default(uuid())
  bookingId    String
  fullName     String
  passportNo   String
  passportExpiry DateTime?
  nationality  String
  dateOfBirth  DateTime
  gender       String
  phone        String?
  email        String?
  mahramName   String?
  mahramRelation String?
  isPrimary    Boolean  @default(false)
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("passengers")
}

// ─── Vehicles & Transport ───────────────────────────────────────────────────

model Vehicle {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  plateNumber   String
  type          String
  capacity      Int
  driverName    String
  driverPhone   String
  driverLicense String?
  driverIqama   String?     // Saudi Iqama # — exactly 10 digits (required on create/update)
  isAvailable   Boolean     @default(true)
  notes         String?
  createdAt     DateTime    @default(now())

  // ── Fleet management ──────────────────────────────────────────────────────
  driverId              String?  // optional link to a driver User account
  initialOdometer       Int      @default(0)    // km — admin-editable baseline
  currentOdometer       Int      @default(0)    // km — auto: initial + trip kms (read-only)
  oilChangeIntervalKm   Int      @default(5000) // alert threshold
  lastOilChangeOdometer Int      @default(0)    // odometer at last oil change

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routes            Route[]
  bookingTransports BookingTransport[]
  fleetTrips        FleetTrip[]
  fleetCashLogs     FleetCashLog[]
  fleetMaintenance  FleetMaintenance[]

  @@unique([tenantId, plateNumber])
  @@index([tenantId])
  @@map("vehicles")
}

// ─── Fleet Management: trips, cash accountability, maintenance ────────────────
model FleetTrip {
  id            String    @id @default(uuid())
  tenantId      String
  vehicleId     String
  driverId      String?
  driverName    String?
  status        String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CANCELLED
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  startLat      Decimal?  @db.Decimal(10, 6)
  startLng      Decimal?  @db.Decimal(10, 6)
  startLabel    String?
  endLat        Decimal?  @db.Decimal(10, 6)
  endLng        Decimal?  @db.Decimal(10, 6)
  endLabel      String?
  startOdometer Int?
  endOdometer   Int?
  distanceKm    Decimal   @default(0) @db.Decimal(10, 2)
  routePoints   Json?     // [{lat,lng,t}]
  purpose       String?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  cashLogs FleetCashLog[]

  @@index([tenantId, startedAt])
  @@index([vehicleId])
  @@map("fleet_trips")
}

model FleetCashLog {
  id          String   @id @default(uuid())
  tenantId    String
  vehicleId   String?
  driverId    String?
  driverName  String?
  tripId      String?
  amount      Decimal  @default(0) @db.Decimal(10, 2)
  currency    String   @default("SAR")
  logDate     DateTime // the day the cash is for
  submittedAt DateTime @default(now()) // server timestamp of submission
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trip    FleetTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([tenantId, logDate])
  @@map("fleet_cash_logs")
}

model FleetMaintenance {
  id                String   @id @default(uuid())
  tenantId          String
  vehicleId         String
  type              String   @default("OIL_CHANGE") // OIL_CHANGE | OTHER
  status            String   @default("PENDING")    // PENDING | COMPLETED | SKIPPED
  dueAtOdometer     Int?
  performedAt       DateTime?
  performedOdometer Int?
  confirmedById     String?
  confirmedByName   String?
  notes             String?
  receiptName       String?  // original filename of the uploaded evidence
  receiptData       String?  // base64 data URL of receipt voucher/invoice
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@map("fleet_maintenance")
}

model Route {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  fromLocation String
  toLocation   String
  description  String?
  vehicleId    String?

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle           Vehicle?           @relation(fields: [vehicleId], references: [id])
  bookingTransports BookingTransport[]

  @@index([tenantId])
  @@map("routes")
}

model BookingTransport {
  id          String   @id @default(uuid())
  bookingId   String
  vehicleId   String
  routeId     String?
  departureAt DateTime?
  arrivalAt   DateTime?
  notes       String?
  // Operational tracking flags toggled from the schedule/transport reports.
  departureDone    Boolean @default(false)
  transportAvailed Boolean @default(false)
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route       Route?   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([departureAt])
  @@map("booking_transports")
}

// ─── Catering ───────────────────────────────────────────────────────────────

model CateringVendor {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  speciality  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mealPlans MealPlan[]

  @@index([tenantId])
  @@map("catering_vendors")
}

model MealPlan {
  id          String         @id @default(uuid())
  vendorId    String
  name        String
  mealType    MealType
  description String?
  pricePerPax Decimal        @db.Decimal(10, 2)
  isActive    Boolean        @default(true)
  vendor      CateringVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  bookingCaterings BookingCatering[]

  @@map("meal_plans")
}

model BookingCatering {
  id         String   @id @default(uuid())
  bookingId  String
  mealPlanId String
  paxCount   Int
  notes      String?
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@map("booking_caterings")
}

// ─── Vouchers, Payments, Invoices ───────────────────────────────────────────

model Voucher {
  id          String      @id @default(uuid())
  tenantId    String
  bookingId   String
  type        VoucherType
  voucherNo   String?     @unique
  pdfUrl      String?
  generatedAt DateTime    @default(now())
  isValid     Boolean     @default(true)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("vouchers")
}

model Payment {
  id           String        @id @default(uuid())
  tenantId     String
  bookingId    String
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("SAR")
  method       PaymentMethod @default(CASH)
  status       PaymentStatus @default(PENDING)
  reference    String?
  gatewayRef   String?       // For Moyasar/Stripe transaction id
  notes        String?
  paidAt       DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payments")
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String
  bookingId   String        @unique
  invoiceNo   String        @unique @default(cuid())
  totalAmount Decimal       @db.Decimal(10, 2)
  paidAmount  Decimal       @db.Decimal(10, 2) @default(0)
  balance     Decimal       @db.Decimal(10, 2)
  vatAmount   Decimal       @db.Decimal(10, 2) @default(0)
  currency    String        @default("SAR")
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invoices")
}

model SystemConfig {
  id          String   @id @default(uuid())
  tenantId    String?  // NULL for global config
  key         String
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_configs")
}

// ─── Audit Log (cross-tenant for SUPER_ADMIN view) ──────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// ─── CRM MODULE ─────────────────────────────────────────────────────────────
// All CRM models are tenant-isolated, feature-flag gated, and purely additive.
// Existing models above are NEVER modified destructively.
// ════════════════════════════════════════════════════════════════════════════

// ─── CRM Enums ──────────────────────────────────────────────────────────────

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  CONFIRMED
  CONVERTED
  LOST
  SPAM
  FOLLOW_UP_PENDING
}

enum CrmLeadSource {
  MANUAL
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  WEBSITE
  REFERRAL
  WALK_IN
  PHONE
  EMAIL
  OTHER
}

enum CrmLeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum CrmTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum CrmIntegrationType {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
}

enum CrmMessageDirection {
  INBOUND
  OUTBOUND
}

enum CrmMessageChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  INTERNAL
  EMAIL
}

// ─── CrmConfig ── Per-tenant CRM settings & feature toggles ─────────────────

model CrmConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  enabled           Boolean  @default(true)
  maxLeads          Int?                      // NULL = unlimited
  maxPipelines      Int      @default(5)
  whatsappEnabled   Boolean  @default(false)
  facebookEnabled   Boolean  @default(false)
  instagramEnabled  Boolean  @default(false)
  autoAssignEnabled Boolean  @default(false)
  defaultPipelineId String?
  settings          Json     @default("{}")   // future extensibility
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("crm_configs")
}

// ─── CrmLead ── Core lead entity with all Umrah travel fields ───────────────

model CrmLead {
  id                 String          @id @default(uuid())
  tenantId           String
  // Contact
  fullName           String
  phone              String?
  whatsappNumber     String?
  email              String?
  country            String?
  nationality        String?
  city               String?
  // Travel interest
  travelInterest     String?
  packageInterest    String?
  budget             Decimal?        @db.Decimal(10, 2)
  budgetCurrency     String          @default("SAR")
  numberOfTravelers  Int?
  preferredDateFrom  DateTime?
  preferredDateTo    DateTime?
  // CRM metadata
  source             CrmLeadSource   @default(MANUAL)
  status             CrmLeadStatus   @default(NEW)
  priority           CrmLeadPriority @default(MEDIUM)
  score              Int             @default(0)
  assignedToId       String?
  tags               String[]
  notes              String?
  // Tracking
  sourceRef          String?         // FB form ID, WA message ID, etc.
  utmCampaign        String?
  utmSource          String?
  isSpam             Boolean         @default(false)
  isDuplicate        Boolean         @default(false)
  mergedIntoId       String?
  convertedAt        DateTime?
  convertedBookingId String?
  lastContactedAt    DateTime?
  followUpAt         DateTime?
  lostReason         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo    User?                @relation("CrmLeadAgent", fields: [assignedToId], references: [id])
  activities    CrmLeadActivity[]
  tasks         CrmTask[]
  opportunities CrmOpportunity[]
  conversations CrmConversation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
  @@index([tenantId, followUpAt])
  @@map("crm_leads")
}

// ─── CrmLeadActivity ── Timeline of everything that happens to a lead ────────

model CrmLeadActivity {
  id          String   @id @default(uuid())
  tenantId    String
  leadId      String
  userId      String?
  action      String   // "status_changed" | "note_added" | "assigned" | "contacted" | etc.
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User?   @relation("CrmActivityUser", fields: [userId], references: [id])

  @@index([leadId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("crm_lead_activities")
}

// ─── CrmPipeline & Stages ── Configurable sales pipelines ───────────────────

model CrmPipeline {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages        CrmPipelineStage[]
  opportunities CrmOpportunity[]

  @@index([tenantId])
  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id          String  @id @default(uuid())
  tenantId    String
  pipelineId  String
  name        String
  position    Int
  color       String  @default("#1B4B35")
  probability Int     @default(50)
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline      CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@index([pipelineId])
  @@index([tenantId])
  @@map("crm_pipeline_stages")
}

// ─── CrmOpportunity ── Deal/opportunity in the pipeline ─────────────────────

model CrmOpportunity {
  id              String   @id @default(uuid())
  tenantId        String
  leadId          String?
  pipelineId      String
  stageId         String
  title           String
  value           Decimal? @db.Decimal(10, 2)
  currency        String   @default("SAR")
  expectedCloseAt DateTime?
  probability     Int      @default(50)
  assignedToId    String?
  notes           String?
  isWon           Boolean  @default(false)
  isLost          Boolean  @default(false)
  lostReason      String?
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       CrmLead?                 @relation(fields: [leadId], references: [id])
  pipeline   CrmPipeline              @relation(fields: [pipelineId], references: [id])
  stage      CrmPipelineStage         @relation(fields: [stageId], references: [id])
  assignedTo User?                    @relation("CrmOpportunityAgent", fields: [assignedToId], references: [id])
  activities CrmOpportunityActivity[]

  @@index([tenantId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, stageId])
  @@index([tenantId, assignedToId])
  @@map("crm_opportunities")
}

model CrmOpportunityActivity {
  id            String   @id @default(uuid())
  tenantId      String
  opportunityId String
  userId        String?
  action        String
  description   String
  metadata      Json?
  createdAt     DateTime @default(now())

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User?          @relation("CrmOppActivityUser", fields: [userId], references: [id])

  @@index([opportunityId])
  @@index([tenantId])
  @@map("crm_opportunity_activities")
}

// ─── CrmTask ── Follow-ups, calls, meetings ──────────────────────────────────

model CrmTask {
  id            String          @id @default(uuid())
  tenantId      String
  leadId        String?
  opportunityId String?
  title         String
  description   String?
  dueAt         DateTime?
  completedAt   DateTime?
  status        CrmTaskStatus   @default(PENDING)
  priority      CrmTaskPriority @default(MEDIUM)
  assignedToId  String?
  createdById   String?
  reminderAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       CrmLead? @relation(fields: [leadId], references: [id])
  assignedTo User?    @relation("CrmTaskAgent", fields: [assignedToId], references: [id])
  createdBy  User?    @relation("CrmTaskCreator", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@map("crm_tasks")
}

// ─── CrmConversation & Messages ── Omnichannel inbox ────────────────────────

model CrmConversation {
  id               String            @id @default(uuid())
  tenantId         String
  leadId           String?
  channel          CrmMessageChannel
  externalId       String?
  participantName  String?
  participantPhone String?
  participantEmail String?
  assignedToId     String?
  isResolved       Boolean           @default(false)
  resolvedAt       DateTime?
  lastMessageAt    DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       CrmLead?     @relation(fields: [leadId], references: [id])
  assignedTo User?        @relation("CrmConvAgent", fields: [assignedToId], references: [id])
  messages   CrmMessage[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId])
  @@index([tenantId, leadId])
  @@index([tenantId, isResolved])
  @@map("crm_conversations")
}

model CrmMessage {
  id             String              @id @default(uuid())
  tenantId       String
  conversationId String
  direction      CrmMessageDirection
  channel        CrmMessageChannel
  body           String
  mediaUrl       String?
  mediaType      String?
  externalId     String?
  sentById       String?
  isRead         Boolean             @default(false)
  deliveryStatus String?
  metadata       Json?
  sentAt         DateTime            @default(now())

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?           @relation("CrmMsgSender", fields: [sentById], references: [id])

  @@index([conversationId])
  @@index([tenantId])
  @@index([tenantId, sentAt])
  @@map("crm_messages")
}

// ─── CrmIntegration ── WhatsApp / Facebook / Instagram config ───────────────

model CrmIntegration {
  id            String             @id @default(uuid())
  tenantId      String
  type          CrmIntegrationType
  isEnabled     Boolean            @default(false)
  credentials   Json               @default("{}")  // encrypted at-rest (follow-up)
  webhookUrl    String?
  webhookSecret String?
  lastSyncAt    DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("crm_integrations")
}

// ─── CrmWebhookLog ── Inbound webhook event log (retry / audit) ─────────────

model CrmWebhookLog {
  id          String   @id @default(uuid())
  tenantId    String?
  source      String   // "whatsapp" | "facebook" | "instagram"
  event       String
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?
  retryCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([source, processed])
  @@index([createdAt])
  @@map("crm_webhook_logs")
}

// ─── CrmAutomationRule ── Trigger → Condition → Action rules ────────────────

model CrmAutomationRule {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  trigger     String   // "lead_created" | "lead_status_changed" | "task_overdue" | "lead_inactivity"
  conditions  Json     @default("[]")
  actions     Json     @default("[]")
  runCount    Int      @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("crm_automation_rules")
}

// ─── CrmNotification ── In-app notifications ────────────────────────────────

model CrmNotification {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  type       String   // "new_lead" | "task_due" | "lead_assigned" | "integration_error"
  title      String
  body       String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("CrmUserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, userId, isRead])
  @@index([tenantId, createdAt])
  @@map("crm_notifications")
}

// ─── PasswordResetToken ── Single-use DB-stored reset tokens ────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique   // 64-char hex from crypto.randomBytes(32)
  expiresAt DateTime
  usedAt    DateTime?           // set when consumed — prevents reuse
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Platform Cost Monitor (SUPER_ADMIN) ─────────────────────────────────────
// Tracks the SaaS owner's own running costs (Railway, Dynadot, Resend, etc.).
// Platform-level — NOT tenant-scoped (no tenantId; not in TENANT_MODELS).

model PlatformCost {
  id              String    @id @default(uuid())
  name            String
  category        String?            // Hosting, Domain, Email, Payments, Monitoring, CDN, Code
  url             String?
  monthlyCost     Decimal   @default(0) @db.Decimal(10, 2)
  currency        String    @default("USD")
  billingCycle    String    @default("MONTHLY") // MONTHLY | YEARLY | ONE_TIME | USAGE
  nextDueDate     DateTime?
  lastPaymentDate DateTime?
  autoRenew       Boolean   @default(true)
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  payments PlatformPayment[]

  @@map("platform_costs")
}

model PlatformPayment {
  id             String   @id @default(uuid())
  platformCostId String
  amount         Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("USD")
  paidAt         DateTime @default(now())
  periodLabel    String?           // e.g. "2026-06"
  method         String?
  reference      String?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())

  platform PlatformCost @relation(fields: [platformCostId], references: [id], onDelete: Cascade)

  @@index([platformCostId])
  @@map("platform_payments")
}
